# Copy to .env and adjust. .env is git-ignored.

# Local Postgres: holds only Airflow's own database now (the earthquake data is in Snowflake).
# WAREHOUSE_DB is the container's default database, left over from the local version.
POSTGRES_USER=quake
POSTGRES_PASSWORD=quake
WAREHOUSE_DB=warehouse

# Any long random string; shared by all Airflow components.
AIRFLOW_JWT_SECRET=change-me-to-a-long-random-string

# S3 landing zone. Keys belong to the quake-pipeline IAM user (infra/aws/README.md).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-2
RAW_BUCKET=quake-pipeline-raw-phs67z

# Snowflake, as the pipeline user with key-pair auth (infra/snowflake/).
# The private key file lives in secrets/ (git-ignored); only its path goes here.
SNOWFLAKE_ACCOUNT=PDAELOQ-HI84501
SNOWFLAKE_USER=PIPELINE_USER
SNOWFLAKE_PRIVATE_KEY_PATH=secrets/snowflake/pipeline_key.p8
SNOWFLAKE_ROLE=PIPELINE_ROLE
SNOWFLAKE_WAREHOUSE=QUAKE_WH
SNOWFLAKE_DATABASE=QUAKE

# Linux only: set to your `id -u` so files Airflow writes are owned by you. Ignored on Docker Desktop.
AIRFLOW_UID=50000
