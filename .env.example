# Copy to .env and adjust. .env is git-ignored.
POSTGRES_USER=quake
POSTGRES_PASSWORD=quake
WAREHOUSE_DB=warehouse

# Any long random string; shared by all Airflow components.
AIRFLOW_JWT_SECRET=change-me-to-a-long-random-string

# Linux only: set to your `id -u` so files Airflow writes are owned by you. Ignored on Docker Desktop.
AIRFLOW_UID=50000
