# Snowflake settings for the dashboard. On Streamlit Community Cloud, paste this (filled in)
# into the app's Settings -> Secrets. To run locally with `streamlit run app.py`, copy it to
# dashboard/.streamlit/secrets.toml, which git ignores. Docker compose uses environment
# variables instead (see docker-compose.yml).

[snowflake]
account = "PDAELOQ-HI84501"
user = "DASHBOARD_USER"
role = "REPORTER_ROLE"
warehouse = "QUAKE_WH"
database = "QUAKE"
# The whole of secrets/snowflake/dashboard_key.p8, BEGIN and END lines included.
# Triple quotes keep the line breaks. Locally you can use private_key_file = "<path>" instead.
private_key = """-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"""
